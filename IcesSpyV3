local function deepclone(v, copies)
    copies = copies or {}
    if type(v) == "table" then
        if copies[v] then return copies[v] end
        local c = {}
        copies[v] = c
        for k, x in next, v do
            c[deepclone(k, copies)] = deepclone(x, copies)
        end
        return c
    elseif typeof(v) == "Instance" then
        return cloneref(v)
    end
    return v
end

-- ---------- serializer (value -> Lua source) ----------
local function fmtstr(s)
    s = s:gsub("[%c\\\"\128-\255]", function(c)
        if c == "\n" then return "\\n"
        elseif c == "\t" then return "\\t"
        elseif c == "\\" then return "\\\\"
        elseif c == '"' then return '\\"'
        end
        return "\\" .. c:byte()
    end)
    return '"' .. s .. '"'
end

local function isIdent(s)
    return type(s) == "string" and s:match("^[%a_][%w_]*$") ~= nil
end

local function i2p(inst)
    if inst == nil then return "nil" end
    if inst == game then return "game" end
    local chain = {}
    local cur = inst
    while cur and cur ~= game do
        table.insert(chain, 1, cur)
        cur = cur.Parent
    end
    if cur ~= game then
        return ("nil --[[ %s is not parented to game ]]"):format(inst.Name)
    end
    local lp = Players.LocalPlayer
    local out, start
    if lp and inst == lp then
        return 'game:GetService("Players").LocalPlayer'
    end
    local first = chain[1]
    if first == workspace then
        out = "workspace"
    elseif game:FindService(first.ClassName) then
        out = ('game:GetService("%s")'):format(first.ClassName)
    else
        out = ("game:WaitForChild(%s)"):format(fmtstr(first.Name))
    end
    for i = 2, #chain do
        local n = chain[i].Name
        out ..= isIdent(n) and ("." .. n) or (":WaitForChild(%s)"):format(fmtstr(n))
    end
    return out
end

local v2s
local function t2s(t, level, seen)
    if seen[t] then return "{} --[[CYCLIC TABLE]]" end
    seen[t] = true
    level += 4
    local pad = string.rep(" ", level)
    local parts, size = {}, 0
    for k, v in next, t do
        size += 1
        if size > 1000 then
            table.insert(parts, pad .. "-- MAXIMUM TABLE SIZE REACHED")
            break
        end
        local key = isIdent(k) and k or ("[" .. v2s(k, level, seen) .. "]")
        table.insert(parts, pad .. key .. " = " .. v2s(v, level, seen))
    end
    seen[t] = nil
    if #parts == 0 then return "{}" end
    return "{\n" .. table.concat(parts, ",\n") .. "\n" .. string.rep(" ", level - 4) .. "}"
end

function v2s(v, level, seen)
    level = level or 0
    seen = seen or {}
    local t = typeof(v)
    if t == "string" then return fmtstr(v)
    elseif t == "number" then
        if v ~= v then return "0/0"
        elseif v == math.huge then return "math.huge"
        elseif v == -math.huge then return "-math.huge" end
        return tostring(v)
    elseif t == "boolean" or t == "nil" then return tostring(v)
    elseif t == "table" then return t2s(v, level, seen)
    elseif t == "Instance" then return i2p(v)
    elseif t == "Vector3" then return ("Vector3.new(%s, %s, %s)"):format(v.X, v.Y, v.Z)
    elseif t == "Vector2" then return ("Vector2.new(%s, %s)"):format(v.X, v.Y)
    elseif t == "CFrame" then return "CFrame.new(" .. table.concat({v:GetComponents()}, ", ") .. ")"
    elseif t == "Color3" then return ("Color3.new(%s, %s, %s)"):format(v.R, v.G, v.B)
    elseif t == "UDim2" then return ("UDim2.new(%s)"):format(tostring(v))
    elseif t == "UDim" then return ("UDim.new(%s)"):format(tostring(v))
    elseif t == "BrickColor" then return ("BrickColor.new(%s)"):format(v.Number)
    elseif t == "EnumItem" then return tostring(v)
    elseif t == "Enum" then return "Enum." .. tostring(v)
    elseif t == "NumberRange" then return ("NumberRange.new(%s, %s)"):format(v.Min, v.Max)
    elseif t == "Rect" then return ("Rect.new(%s, %s, %s, %s)"):format(v.Min.X, v.Min.Y, v.Max.X, v.Max.Y)
    elseif t == "Ray" then return ("Ray.new(%s, %s)"):format(v2s(v.Origin), v2s(v.Direction))
    elseif t == "TweenInfo" then
        return ("TweenInfo.new(%s, %s, %s, %s, %s, %s)"):format(v.Time, tostring(v.EasingStyle), tostring(v.EasingDirection), v.RepeatCount, tostring(v.Reverses), v.DelayTime)
    elseif t == "function" then return "function() end --[[function]]"
    end
    return ("nil --[[%s is not supported]]"):format(t)
end

--- Builds the script shown in the codebox
function genScript(remote, args)
    local gen = ("-- Generated with icey pookie chaos boo boo generator (%s)\n"):format(remote.ClassName)
    if #args > 0 then
        local ok, res = pcall(v2s, args)
        gen ..= "local args = " .. (ok and res or ("{} -- serializer error: " .. tostring(res))) .. "\n\n"
        if remote:IsA("RemoteEvent") then
            gen ..= i2p(remote) .. ":FireServer(unpack(args))"
        else
            gen ..= i2p(remote) .. ":InvokeServer(unpack(args))"
        end
    else
        if remote:IsA("RemoteEvent") then
            gen ..= i2p(remote) .. ":FireServer()"
        else
            gen ..= i2p(remote) .. ":InvokeServer()"
        end
    end
    return gen
end

-- ---------- capture ----------
local function remoteHandler(kind, remote, args)
    local id = GetId(remote)
    if blacklist[id] or blacklist[remote.Name] then return end

    if configs.autoblock then
        if excluding[id] then return end
        if not history[id] then
            history[id] = {badOccurances = 0, lastCall = tick()}
        end
        if tick() - history[id].lastCall < 1 then
            history[id].badOccurances += 1
            return
        else
            history[id].badOccurances = 0
        end
        if history[id].badOccurances > 3 then
            excluding[id] = true
            return
        end
        history[id].lastCall = tick()
    end

    newRemote(kind, {
        remote = remote,
        args = args,
        id = id,
        method = kind == "event" and "OnClientEvent" or "OnClientInvoke",
        metamethod = "listener",
        returnvalue = {},
    })
end

local function onRemote(kind, remote, ...)
    if not toggle then return end
    local args = deepclone({...})
    task.spawn(remoteHandler, kind, remote, args)
end

local function track(inst)
    if listeners[inst] then return end
    if inst:IsA("RemoteEvent") then
        listeners[inst] = {conn = inst.OnClientEvent:Connect(function(...)
            onRemote("event", inst, ...)
        end)}
    elseif inst:IsA("RemoteFunction") then
        if not getcallbackmember then return end
        local ok, old = pcall(getcallbackmember, inst, "OnClientInvoke")
        if ok and type(old) == "function" then
            local wrapper = function(...)
                onRemote("function", inst, ...)
                return old(...)
            end
            listeners[inst] = {old = old, wrapper = wrapper}
            inst.OnClientInvoke = wrapper
        end
    end
end

local function restoreListeners()
    for inst, l in next, listeners do
        if l.conn then
            l.conn:Disconnect()
        elseif l.old then
            pcall(function() inst.OnClientInvoke = l.old end)
        end
    end
    clear(listeners)
end

--- Called by the SimpleSpy logo / startup. First enable scans the game.
local function toggleSpyMethod()
    toggle = not toggle
    if toggle and not scanned then
        scanned = true
        for _, v in ipairs(game:GetDescendants()) do
            pcall(track, v)
        end
        table.insert(connections, game.DescendantAdded:Connect(function(d)
            pcall(track, d)
        end))
    end
end

