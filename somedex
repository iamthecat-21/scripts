backButton.Activated:Connect(function()
	local msg = functions.back()
	if msg ~= "success" then
		output(msg, true)
	end
end)

copyButton.Activated:Connect(function()
	local msg, ok = functions.copypath()
	output(msg, not ok)
end)

closeButton.Activated:Connect(function()
	functions.close()
end)

searchbox:GetPropertyChangedSignal("Text"):Connect(applySearch)

commandbox.FocusLost:Connect(function(enter)
	if enter then
		local args = commandbox.Text:split(" ")
		local command = args[1]
		local func = functions[command]
		if func then
			table.remove(args, 1)
			local success, result = pcall(func, unpack(args))
			output(tostring(result), not success)
			commandbox.Text = ""
		else
			output("invalid command", true)
		end
	end
end)

