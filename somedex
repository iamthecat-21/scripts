functions = {
	open = function(name)
		local toopen = typeof(name) == "Instance" and name or findRow(name)
		if toopen or selected then
			local instance = (toopen or selected).object.Value
			changecurrentinstance(instance)
			updateexplorer()
		else
			return "invalid instance"
		end
		return "instance opened", true
	end,
	back = function()
		if currentinstance ~= game then
			changecurrentinstance(currentinstance.Parent)
			updateexplorer()
		else
			return "you cannot go higher than game"
		end
		return "success"
	end,
	destroy = function(name)
		local toopen = (name and findRow(name)) or selected
		if toopen then
			toopen.object.Value:Destroy()
			updateproperties()
		else
			return "invalid instance"
		end
		return "instance destroyed", true
	end,
	rename = function(name, newname)
		local toopen = (name and findRow(name)) or selected
		if toopen and newname then
			toopen.object.Value.Name = newname
			updateexplorer()
		else
			return "invalid instance"
		end
		return "instance renamed", true
	end,
	create = function(classname, name)
		local thing = Instance.new(classname)
		if name then
			thing.Name = name
		end
		thing.Parent = currentinstance
		updateexplorer()
		return "instance created", true
	end,
	fire = function(name)
		local toopen = (name and findRow(name)) or selected
		if toopen then
			toopen = toopen.object.Value
		end
		if toopen then
			if toopen:IsA("RemoteFunction") then
				return "success, result : " .. tostring(toopen:InvokeServer()), true
			elseif toopen:IsA("RemoteEvent") then
				toopen:FireServer()
				return "fired!", true
			elseif toopen:IsA("BindableEvent") then
				toopen:Fire()
				return "fired!", true
			elseif toopen:IsA("BindableFunction") then
				return "success, result : " .. tostring(toopen:Invoke()), true
			else
				return "instance is not a remote"
			end
		end
		return "invalid instance"
	end,
	changeproperty = function(propertyname, newvalue, name)
		local toopen = (name and findRow(name)) or selected
		if toopen then
			toopen = toopen.object.Value
			local property = toopen[propertyname]
			if typeof(property) == "Instance" then
				return "invalid property"
			end
			local t = typeof(property)
			if t == "number" then
				toopen[propertyname] = tonumber(newvalue)
			elseif t == "string" then
				toopen[propertyname] = newvalue
			else
				toopen[propertyname] = loadstring("return " .. newvalue)()
			end
			return "successfully changed property", true
		end
		return "invalid property"
	end,
	decompile = function(name)
		local row = (name and findRow(name)) or selected
		if not row then
			return "invalid instance"
		end
		return openViewer(row.object.Value)
	end,
	copypath = function(name)
		local row = (name and findRow(name)) or selected
		local target = row and row.object.Value or currentinstance
		if not target then
			return "invalid instance"
		end

		local path = target:GetFullName()
		local clip = setclipboard or toclipboard or (syn and syn.write_clipboard)
		if clip then
			clip(path)
			return "copied: " .. path, true
		end
		return "your executor has no clipboard function. path: " .. path
	end,
	close = function()
		for _, v in pairs(connections) do
			v:Disconnect()
		end
		if selectedConn then
			selectedConn:Disconnect()
		end
		ScreenGui:Destroy()
		return "closed", true
	end,
	help = function()
		return "open (name) - opens the selected instance\n"
			.. "copypath (name) - copies the path of the selected instance (or current folder)\n"
			.. "decompile (name) - opens the script viewer (or right-click a script)\n"
			.. "close - closes the explorer\n"
			.. "back - go to the parent (or use the ◀ button)\n"
			.. "destroy (name) - destroys the selected instance\n"
			.. "rename (name) (newname) - renames the selected instance\n"
			.. "create (classname) (name) - creates an instance here\n"
			.. "fire (name) - fires the remote/bindable\n"
			.. "changeproperty (prop) (value) (name) - edits a property\n"
			.. "help - shows this list"
	end,
}

