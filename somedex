local MAX_DISPLAY = 100000 -- very long text can lag the TextBox, copy still gets everything
local currentSource = ""

local function openViewer(instance)
	if not instance or not instance:IsA("LuaSourceContainer") then
		return "not a script"
	end

	viewerTitle.Text = instance:GetFullName()
	codeBox.Text = "-- decompiling..."
	currentSource = ""
	viewer.Visible = true

	task.spawn(function()
		local reader = decompile or function(s) return s.Source end
		local ok, result = pcall(reader, instance)

		if ok and type(result) == "string" and result ~= "" then
			currentSource = result
			if #result > MAX_DISPLAY then
				codeBox.Text = result:sub(1, MAX_DISPLAY) .. "\n\n-- [truncated for display, copy gets the full source]"
			else
				codeBox.Text = result
			end
		else
			currentSource = ""
			codeBox.Text = "-- could not decompile this script\n-- " .. tostring(result)
		end
	end)

	return "viewer opened", true
end

viewerClose.Activated:Connect(function()
	viewer.Visible = false
	codeBox.Text = ""
	currentSource = ""
end)

viewerCopy.Activated:Connect(function()
	local clip = setclipboard or toclipboard or (syn and syn.write_clipboard)
	if clip and currentSource ~= "" then
		clip(currentSource)
		viewerCopy.Text = "✔"
		task.delay(1, function()
			viewerCopy.Text = "📋"
		end)
	else
		output(clip and "nothing to copy" or "your executor has no clipboard function", true)
	end
end)

