local function addinstance(instance, index)
	pcall(function()
		local c = Instance.new("TextButton")
		c.Size = UDim2.new(1, 0, 0, 26)
		c.BackgroundColor3 = THEME.row
		c.BorderSizePixel = 0
		c.Text = ""
		c.AutoButtonColor = false
		c.LayoutOrder = index
		c.Name = instance.Name
		corner(c, 4)

		local thing = Instance.new("ObjectValue")
		thing.Name = "object"
		thing.Value = instance
		thing.Parent = c

		local icon = Instance.new("ImageLabel")
		icon.BackgroundTransparency = 1
		icon.Position = UDim2.new(0, 6, 0.5, -9)
		icon.Size = UDim2.new(0, 18, 0, 18)
		icon.Image = getImageFromInstance(instance)
		icon.Parent = c

		local label = makeLabel(c, instance.Name, 13)
		label.Name = "TextLabel"
		label.Position = UDim2.new(0, 30, 0, 0)
		label.Size = UDim2.new(1, -36, 1, 0)

		c.MouseEnter:Connect(function()
			if selected ~= c then c.BackgroundColor3 = THEME.rowHover end
		end)
		c.MouseLeave:Connect(function()
			if selected ~= c then c.BackgroundColor3 = THEME.row end
		end)

		local lastclicked = 0
		c.Activated:Connect(function()
			local now = tick()
			if selected == c and now - lastclicked <= 0.4 then
				functions.open(c)
				return
			end
			lastclicked = now
			setSelected(c)
		end)

		c.MouseButton2Click:Connect(function()
			setSelected(c)
			if instance:IsA("LuaSourceContainer") then
				openViewer(instance)
			end
		end)

		c.Parent = Explore
		table.insert(rows, { button = c, name = instance.Name, lname = instance.Name:lower() })
	end)
end

local ROOT_SERVICES = {
	"Workspace", "Players", "CoreGui", "Lighting", "MaterialService",
	"ReplicatedFirst", "ReplicatedStorage", "ServerScriptService",
	"ServerStorage", "StarterGui", "StarterPack", "StarterPlayer",
	"Teams", "SoundService", "TextChatService",
}

local function updateexplorer()
	clearexplorer()
	if currentinstance then
		for i, v in currentinstance:GetChildren() do
			if currentinstance == game then
				if table.find(ROOT_SERVICES, v.Name) then
					addinstance(v, i)
				end
			else
				addinstance(v, i)
			end
		end
	end
	pathtext.Text = currentinstance and currentinstance:GetFullName() or ""
	backButton.BackgroundTransparency = (currentinstance == game) and 0.6 or 0
	applySearch()
end

local function changecurrentinstance(new)
	for _, v in pairs(connections) do
		v:Disconnect()
	end
	connections = {}
	if new then
		table.insert(connections, new.ChildAdded:Connect(updateexplorer))
		table.insert(connections, new.AncestryChanged:Connect(updateexplorer))
	end
	currentinstance = new
	searchbox.Text = ""
end

