-- getproperties fallback
if not getproperties then
	getfenv().getproperties = function(instance)
		if not instance or typeof(instance) ~= "Instance" then return {} end
		local propertiesTable = {}

		local ok, reflected = pcall(function()
			return game:GetService("ReflectionService"):GetPropertiesOfClass(instance.ClassName)
		end)

		if ok and reflected then
			for _, propData in ipairs(reflected) do
				local readOk, value = pcall(function()
					return instance[propData.Name]
				end)
				if readOk then
					propertiesTable[propData.Name] = value
				end
			end
		else
			for _, propName in ipairs({"Name", "ClassName", "Parent", "Archivable"}) do
				pcall(function() propertiesTable[propName] = instance[propName] end)
			end
		end

		return propertiesTable
	end
end

